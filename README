│  └─ results/
│     └─ (result logs)
├─ results/
│  └─ results_<scenario>_<timestamp>.mat
├─ scripts/
│  └─ runSingleScenario.m
└─ src/
   └─ +trackbench/
      ├─ runScenario.m
      ├─ +detections/
      │  └─ createDetections.m
      ├─ +loader/
      │  └─ loadConfig.m
      ├─ +metrics/
