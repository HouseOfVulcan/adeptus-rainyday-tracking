{
  "name": "standard_crossing",
  "description": "Reusable crossing-target template",
  "sensor_component": "sensors_dasr",
  "defaults": {
    "scenario.duration_s": 60,
    "scenario.num_targets": 2,
    "degradation.enabled": false
  },
  "targets": [
    {
      "behavior": "crossing",
      "speed_kmh": 800,
      "start_pos": [-5000, -20000, -3000],
      "end_pos": [5000, -20000, -3000],
      "altitude_m": 3000
    },
    {
      "behavior": "crossing",
      "speed_kmh": 800,
      "start_pos": [0, -25000, -3200],
      "end_pos": [0, -15000, -3200],
      "altitude_m": 3200
    }
  ]
}
